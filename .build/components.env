# Pinned component versions shipped in the mlab-node package, sourced by
# .build/stage-binaries.sh. Every file is verified against its sha256 here
# before it is staged.
#
# To bump an M-Lab component, change its tag and copy the new sha256 from the
# checksums.txt attached to that GitHub release.

# Official release binaries published by each component's release-binaries
# workflow, downloaded from
#   https://github.com/<repository>/releases/download/<tag>/<binary>_<tag>_linux_amd64
# Fields: staged name, repository, tag, release binary, sha256.
RELEASE_BINARIES=(
  "ndt-server                    m-lab/ndt-server         v0.26.1  ndt-server         8657d5b92761dbb78cb90b18e06f64aa6f54b6583b37a8772ccbb9534dcb80dd"
  "generate-schemas-ndt7         m-lab/ndt-server         v0.26.1  generate-schemas   461f1d4d3a012112b2b0de9f8a0957f6fd1ce5c127ba06748c40cb48d5a7b812"
  "heartbeat                     m-lab/locate             v0.19.1  heartbeat          f38b4e949280b75cb1c15432e9d97502d24fe30cf2888c95b2beb484dd11b65d"
  "uuid-annotator                m-lab/uuid-annotator     v0.5.11  uuid-annotator     ae38b755a4cf3568cda394c68f308e61584d58f0da573eff6f15abedb73f1b78"
  "generate-schemas-annotation2  m-lab/uuid-annotator     v0.5.11  generate-schemas   197938faa349ae8ca2c828d93cd0c8ae53efb2aa3cdfed70d36dc26169f0061b"
  "jostler                       m-lab/jostler            v1.1.5   jostler            33375d267835fa176d4ce4b27fd8c6e4249299d11e7014a24bc3a85efcef955e"
  "traceroute-caller             m-lab/traceroute-caller  v0.12.1  traceroute-caller  a6771c010feb699a55c75ba53d46b462135008047e5850d0d5b848311a746198"
  "generate-schemas-traceroute   m-lab/traceroute-caller  v0.12.1  generate-schemas   199fcecf5bcdd04a4b173b7e888c74fe6b7cd371edefee658a89dd4445e144ff"
