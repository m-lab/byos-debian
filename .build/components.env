# Pinned component versions shipped in the mlab-node package, sourced by
# .build/stage-binaries.sh. Every file is verified against its sha256 here
# before it is staged.
#
# To bump an M-Lab component, change its tag and copy the new sha256 from the
# checksums.txt attached to that GitHub release.

# Official release binaries published by each component's release-binaries
# workflow, downloaded from
#   https://github.com/<repository>/releases/download/<tag>/<binary>_<tag>_linux_amd64
# Fields: staged name, repository, tag, release binary, sha256.
RELEASE_BINARIES=(
  "ndt-server                    m-lab/ndt-server         v0.26.0  ndt-server         f4bf0707ed09b8c58bd3f52166811d2401dc58e32a8848eb8bbfca1fbcd70432"
  "generate-schemas-ndt7         m-lab/ndt-server         v0.26.0  generate-schemas   8a1996261f21d9ec2f4653056d4193d08bf3891b7359c4863197f1d3ed459a54"
  "heartbeat                     m-lab/locate             v0.19.1  heartbeat          f38b4e949280b75cb1c15432e9d97502d24fe30cf2888c95b2beb484dd11b65d"
  "uuid-annotator                m-lab/uuid-annotator     v0.5.10  uuid-annotator     45aeba03bd7a191c39d931bd22c0abff05470465366663b819d7eb27279e4117"
  "generate-schemas-annotation2  m-lab/uuid-annotator     v0.5.10  generate-schemas   bd2ae97bcfe3d14c47349e2ecaeefcf1e6b79a1c13992de10cd1c052be36b1bc"
  "jostler                       m-lab/jostler            v1.1.4   jostler            141d37ccd11deca052a03084758756339d98e2cd1733fb02c488a95192c5e964"
  "traceroute-caller             m-lab/traceroute-caller  v0.12.0  traceroute-caller  8c4f89e9afe363b99681b9776e9bf8022fa5ce6141be088f817ea59fbe6af268"
  "generate-schemas-traceroute   m-lab/traceroute-caller  v0.12.0  generate-schemas   09057be33496661ebef7348d163f4edfdf2d4afbf4a55be90bdbfdee12046c64"
  "autojoin-register             m-lab/autojoin           v0.2.13  register           fc125e0b36eb58faf32425bf2d8086f9836082289e1403157df7c5916526a971"
)

