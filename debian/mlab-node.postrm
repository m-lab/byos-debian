#!/bin/sh
set -e

# The configuration files are generated by the postinst from the debconf
# answers (not conffiles), so dpkg does not remove them: do it on purge, along
# with the unattended-upgrades snippet and the node's state (registration
# data and credentials, schemas, results not yet uploaded, certificates,
# runtime sockets). The debconf entries are purged by the debhelper snippet
# below. The mlab-node system user stays, as sysusers.d users do.
if [ "$1" = "purge" ]; then
    rm -f /etc/mlab/mlab-node.env /etc/mlab/api-key.env
    rm -f /etc/apt/apt.conf.d/52mlab-node-unattended-upgrades
    rmdir /etc/mlab 2>/dev/null || true
    rm -rf /var/lib/mlab /run/mlab
fi

#DEBHELPER#
