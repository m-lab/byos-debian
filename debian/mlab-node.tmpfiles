# Persistent state under /var/lib/mlab and runtime dirs under /run/mlab.
# setgid (2xxx) so files and sockets created here inherit the mlab-node group.

# Persistent state.
d /var/lib/mlab                 0755 mlab-node mlab-node -
d /var/lib/mlab/node            2750 mlab-node mlab-node -
d /var/lib/mlab/schemas         2755 mlab-node mlab-node -
d /var/lib/mlab/resultsdir      2755 mlab-node mlab-node -
d /var/lib/mlab/resultsdir/ndt  2755 mlab-node mlab-node -
d /var/lib/mlab/autocert        2750 mlab-node mlab-node -

# Runtime (tmpfs, recreated each boot).
d /run/mlab                     0755 mlab-node mlab-node -
d /run/mlab/sockets             2770 mlab-node mlab-node -
d /run/mlab/metadata            2755 mlab-node mlab-node -

# We want the API key file to be 0600 root:root. The postinst creates it
# that way (from /usr/share/mlab/templates/api-key.env); the line below
# makes systemd-tmpfiles enforce the permissions as well, on package
# install and during each boot. The implication is that a sysadmin
# changing the file permissions would see such changes reverted after
# the next boot. We add a note about this here, as well as in the file
# itself, since it may be confusing.
#
# Regarding our choice to use 0600 root:root, it is safe because we use
# `EnvironmentFile=`, documented in systemd.exec(5) as follows:
#
#     The files listed with this directive will be read shortly before
#     the process is executed [...] The files are read from the file
#     system of the service manager, before any file system changes like
#     bind mounts take place.
#
# The service manager runs as root *for system services*: bind
# mounting and privilege dropping happen inside the spawned child. The
# source code of systemd v259 confirms our interpretation: see `exec_spawn`
# in `src/core/execute.c`: it loads the env first.
z /etc/mlab/api-key.env         0600 root root -
