# See README.md for documentation regarding ownership and permissions.
#
# See also `mlab-node.sysusers`.

# Using `0600 root:root` because only systemd needs to source it ahead of starting units.
z /etc/mlab-node/api-key.env                       0600 root          root          -

d /run/mlab-node                                   0750 root          mlab-node     -

# The metadata is only sourced by systemd when starting units so group does not need access.
d /run/mlab-node/metadata                          0700 mlab-node     mlab-node     -

# The socket dirs require the other group to be setgid to allow for cross connectivity.
d /run/mlab-node/sockets                           0750 root          mlab-node     -
d /run/mlab-node/sockets/ndt                       0750 root          mlab-node     -
d /run/mlab-node/sockets/ndt/events                2750 mlab-node-ndt mlab-node-event-socket -
d /run/mlab-node/sockets/ndt/uuid-annotator        2750 mlab-node     mlab-node-ndt -

d /var/lib/mlab-node                               0750 root          mlab-node     -

# Each service gets its private autocert dir. We prefer `/var/lib` to `/var/cache` because the
# latter has the "OK to wipe" semantics, but Let's Encrypt has rate limits!
d /var/lib/mlab-node/autocert                      0750 root          mlab-node     -
d /var/lib/mlab-node/autocert/ndt                  0700 mlab-node-ndt mlab-node-ndt -

# We separate data private to user `mlab-node` and data shared with the `mlab-node` group.
d /var/lib/mlab-node/node                          0750 root          mlab-node     -
d /var/lib/mlab-node/node/private                  0700 mlab-node     mlab-node     -
d /var/lib/mlab-node/node/shared                   0750 mlab-node     mlab-node     -

# Schemas are written by `mlab-node` and the group needs to read them.
d /var/lib/mlab-node/schemas                       0750 mlab-node     mlab-node     -

# Results awaiting upload and subsequent deletion.
d /var/spool/mlab-node                             0750 root          mlab-node     -
d /var/spool/mlab-node/ndt                         0750 root          mlab-node     -

# Data entirely managed by the `mlab-node` identity.
d /var/spool/mlab-node/ndt/annotation2             0700 mlab-node     mlab-node     -

# Jostler has `mlab-node-ndt` as a supplementary group and must be able to write the
# directories to delete already uploaded data.
d /var/spool/mlab-node/ndt/hopannotation2          0770 mlab-node-ndt mlab-node-ndt -
d /var/spool/mlab-node/ndt/ndt5                    0770 mlab-node-ndt mlab-node-ndt -
d /var/spool/mlab-node/ndt/ndt7                    0770 mlab-node-ndt mlab-node-ndt -
d /var/spool/mlab-node/ndt/scamper2                0770 mlab-node-ndt mlab-node-ndt -
