# See README.md for documentation regarding users and permissions.
#
# See also `mlab-node.tmpfiles`.

u mlab-node     - "M-Lab node core services" /var/lib/mlab-node /usr/sbin/nologin
u mlab-node-ndt - "M-Lab node NDT services"  /var/lib/mlab-node /usr/sbin/nologin

# Provide read and traverse access to group-shared dirs.
m mlab-node-ndt mlab-node
