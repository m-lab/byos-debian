#!/bin/sh
# Debconf config script for mlab-node: asks for the node's configuration.
#
# Every question is pre-filled, in this order of precedence:
#   1. the value already in /etc/mlab/mlab-node.env (an operator edit or a
#      previous run); a non-empty value also marks the question as seen, so
#      upgrades never re-ask what is already configured;
#   2. a value preseeded in the debconf database (debconf-set-selections);
#   3. on a fresh install or dpkg-reconfigure, a best guess derived from the
#      host (public IPs, default-route interface, link speed, virtualization
#      detection). Guesses never fail the script: a
#      heuristic that cannot decide leaves the field empty.
# The postinst writes the answers back to /etc/mlab/*.env. The API key is not
# kept in the debconf database: it is read from /etc/mlab/api-key.env only to
# decide whether to ask, and the postinst clears it after writing the file.
#
# This script runs before the package is unpacked, so it cannot rely on the
# package's own files, and its dependencies may not be installed yet: every
# external tool is optional.
set -e

. /usr/share/debconf/confmodule
db_version 2.0

ENV_FILE=/etc/mlab/mlab-node.env
KEY_FILE=/etc/mlab/api-key.env

have() { command -v "$1" >/dev/null 2>&1; }

# env_value KEY FILE: the value assigned to KEY in FILE (last assignment wins,
# surrounding quotes stripped), or nothing if FILE is unreadable or KEY unset.
env_value() {
  [ -r "$2" ] || return 0
  sed -n "s/^[[:space:]]*$1=//p" "$2" | tail -n 1 | sed "s/^[\"']//; s/[\"']\$//"
}

# --- heuristics: print a guess, or nothing ---------------------------------

# Public addresses: ask an external service what address our traffic comes
# from (a NATed host, e.g. a cloud VM, has no public address on its
# interfaces), falling back to the source address of the default route if it
# is not a private/link-local one.
guess_ipv4() {
  if have curl; then
    v=$(curl -4 -fs -m 5 https://ipinfo.io/ip 2>/dev/null || true)
    case "$v" in *.*.*.*) echo "$v"; return 0 ;; esac
  fi
  have ip || return 0
  ip -4 -o route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' \
    | grep -Ev '^(10\.|127\.|169\.254\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.)' \
    || true
}

guess_ipv6() {
  if have curl; then
    v=$(curl -6 -fs -m 5 https://v6.ipinfo.io/ip 2>/dev/null || true)
    case "$v" in *:*) echo "$v"; return 0 ;; esac
  fi
  have ip || return 0
  ip -6 -o route get 2001:4860:4860::8888 2>/dev/null | sed -n 's/.* src \([0-9a-f:]*\).*/\1/p' \
    | grep -Ev '^(fe80:|f[cd][0-9a-f][0-9a-f]:|::1$)' || true
}

guess_interface() {
  have ip || return 0
  { ip -4 -o route show default 2>/dev/null; ip -6 -o route show default 2>/dev/null; } \
    | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n 1
}

# Link speed reported by the driver, in Mbit/s (-1 or unreadable on many
# virtual NICs), rounded down to whole gigabits.
guess_uplink() {
  [ -n "$1" ] && [ -r "/sys/class/net/$1/speed" ] || return 0
  speed=$(cat "/sys/class/net/$1/speed" 2>/dev/null) || return 0
  case "$speed" in ''|*[!0-9]*) return 0 ;; esac
  [ "$speed" -ge 1000 ] || return 0
  echo "$((speed / 1000))g"
}

# M-Lab's recommendations for 1g and 10g uplinks; 75% of the uplink otherwise
# (the ratio the 10g recommendation and M-Lab's own 40g sites use).
guess_maxrate() {
  case "$1" in
    1g) echo 150000000 ;;
    10g) echo 7000000000 ;;
    *g)
      n=${1%g}
      case "$n" in ''|*[!0-9]*) return 0 ;; esac
      echo "$((n * 750000000))" ;;
  esac
}

guess_type() {
  if have systemd-detect-virt; then
    if systemd-detect-virt -q; then echo virtual; else echo physical; fi
  elif grep -q '^flags.*[[:space:]]hypervisor\([[:space:]]\|$\)' /proc/cpuinfo 2>/dev/null; then
    echo virtual
  elif [ -r /sys/class/dmi/id/sys_vendor ] \
    && grep -Eqi 'qemu|kvm|vmware|xen|virtualbox|innotek|google|amazon ec2|microsoft corporation|parallels|bochs|openstack|nutanix|digitalocean|linode|vultr|alibaba' \
      /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/product_name 2>/dev/null; then
    echo virtual
  fi
}

# --- validation: print a reason if $1 is invalid, nothing if fine -----------

valid_iata() { echo "$1" | grep -Eq '^[a-z]{3}$' || echo "expected exactly 3 letters, e.g. lhr"; }
valid_probability() {
  echo "$1" | grep -Eq '^(0|0?\.[0-9]+|1|1\.0+)$' || echo "expected a number between 0 and 1, e.g. 0.1"
}
valid_interface() {
  if [ -d /sys/class/net ] && [ ! -e "/sys/class/net/$1" ]; then
    echo "no such network interface on this machine (see: ip link)"
  fi
}
valid_uplink() { echo "$1" | grep -Eq '^[1-9][0-9]*g$' || echo "expected an integer followed by g, e.g. 10g"; }
valid_maxrate() { echo "$1" | grep -Eq '^[1-9][0-9]*$' || echo "expected an integer number of bit/s, e.g. 7000000000"; }
valid_ipv4() { echo "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || echo "expected a dotted-quad IPv4 address"; }
valid_ipv6() { echo "$1" | grep -Eq '^[0-9a-fA-F:]*:[0-9a-fA-F:.]*$' || echo "expected an IPv6 address"; }
valid_none() { :; }

# --- flow --------------------------------------------------------------------

# Heuristics run on a fresh install (no configuration file yet) and on
# dpkg-reconfigure, where the operator sees every proposal. On an upgrade an
# empty field stays empty: guessing there would silently fill in a value the
# operator may have left blank on purpose (IPV6 in particular).
GUESS=0
if [ ! -e "$ENV_FILE" ] || [ "$1" = reconfigure ] || [ -n "$DEBCONF_RECONFIGURE" ]; then
  GUESS=1
fi

# seed QUESTION KEY [HEURISTIC ARGS...]: pre-fill QUESTION per the precedence
# described at the top.
seed() {
  q=$1; key=$2; shift 2
  fv=$(env_value "$key" "$ENV_FILE")
  if [ -n "$fv" ]; then
    db_set "$q" "$fv"
    db_fset "$q" seen true
    return 0
  fi
  db_get "$q"
  if [ -n "$RET" ] || [ "$GUESS" -eq 0 ] || [ $# -eq 0 ]; then
    return 0
  fi
  guess=$("$@" 2>/dev/null || true)
  if [ -n "$guess" ]; then
    db_set "$q" "$guess"
  fi
}

# ask QUESTION REQUIRED LABEL VALIDATOR [NORMALIZER]: show QUESTION, at
# priority critical when it is required and still has no value (nothing
# sensible to fall back on), high otherwise. Re-ask while the answer fails
# VALIDATOR, but only if the question was actually shown (rc 0): a
# noninteractive run must never loop, and a value it could not ask about is
# reported by the postinst instead.
ask() {
  q=$1; required=$2; label=$3; validate=$4; normalize=${5:-cat}
  db_get "$q"
  prio=high
  if [ "$required" = yes ] && [ -z "$RET" ]; then prio=critical; fi
  while :; do
    shown=1
    db_input "$prio" "$q" || shown=0
    db_go || true
    db_get "$q"
    val=$(printf '%s' "$RET" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | $normalize)
    [ "$val" = "$RET" ] || db_set "$q" "$val"
    [ -n "$val" ] || return 0
    reason=$("$validate" "$val")
    [ -n "$reason" ] || return 0
    if [ "$shown" -eq 0 ]; then return 0; fi
    db_subst mlab-node/invalid-value setting "$label"
    db_subst mlab-node/invalid-value reason "$reason"
    db_input critical mlab-node/invalid-value || true
    db_go || true
    db_fset "$q" seen false
  done
}

lower() { tr 'A-Z' 'a-z'; }

# The key is never stored in debconf, so there is nothing to seed; an existing
# key only marks the question seen. An empty answer keeps the existing key.
if [ -n "$(env_value API_KEY "$KEY_FILE")" ]; then
  db_fset mlab-node/api-key seen true
  ask mlab-node/api-key no "the API key" valid_none
else
  ask mlab-node/api-key yes "the API key" valid_none
fi

# No guess for the IATA code: M-Lab wants the largest international airport
# of the metro, and a nearest-airport lookup proposes airfields (see the
# template text). The operator must choose.
seed mlab-node/iata IATA
ask mlab-node/iata yes "the IATA code" valid_iata lower

seed mlab-node/probability PROBABILITY
ask mlab-node/probability yes "the probability" valid_probability

seed mlab-node/interface-name INTERFACE_NAME guess_interface
ask mlab-node/interface-name yes "the interface name" valid_interface

# The uplink guess reads the link speed of the interface just chosen, and the
# max-rate recommendation follows from the uplink just chosen.
db_get mlab-node/interface-name; iface=$RET
seed mlab-node/uplink UPLINK guess_uplink "$iface"
ask mlab-node/uplink yes "the uplink speed" valid_uplink lower

db_get mlab-node/uplink; uplink=$RET
seed mlab-node/interface-maxrate INTERFACE_MAXRATE guess_maxrate "$uplink"
ask mlab-node/interface-maxrate yes "the maximum transmit rate" valid_maxrate

seed mlab-node/ipv4 IPV4 guess_ipv4
ask mlab-node/ipv4 yes "the IPv4 address" valid_ipv4

seed mlab-node/ipv6 IPV6 guess_ipv6
ask mlab-node/ipv6 no "the IPv6 address" valid_ipv6 lower

seed mlab-node/type TYPE guess_type
ask mlab-node/type yes "the machine type" valid_none

db_input high mlab-node/unattended-upgrades || true
db_go || true
