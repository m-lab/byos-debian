# Everything else (config, scripts, systemd units, html) ships from root/,
# copied wholesale by debian/rules' override_dh_auto_install. Only the
# generated build output — not tracked, not part of root/ — is listed here.

# Component binaries (built from the pinned sources by .build/build-binaries.sh).
binaries/ndt-server                     usr/libexec/mlab-node
binaries/heartbeat                      usr/libexec/mlab-node
binaries/uuid-annotator                 usr/libexec/mlab-node
binaries/jostler                        usr/libexec/mlab-node
binaries/traceroute-caller              usr/libexec/mlab-node
binaries/scamper                        usr/libexec/mlab-node
binaries/autojoin-register              usr/libexec/mlab-node
binaries/node-exporter                  usr/libexec/mlab-node
binaries/generate-schemas-ndt7          usr/libexec/mlab-node
binaries/generate-schemas-annotation2   usr/libexec/mlab-node
binaries/generate-schemas-traceroute    usr/libexec/mlab-node

# IPInfo AS-names CSV (from the uuid-annotator repo), read by the
# uuid-annotator via -asname.url.
binaries/asnames.ipinfo.csv             usr/share/mlab-node
