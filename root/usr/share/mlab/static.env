# Package-owned constants for the mlab-node services that define
# the defaults overridden by `/etc/mlab/mlab-node.env`.
#
# While `/etc/mlab/mlab-node.env` is a config file that the
# admin is supposed to modify manually, `static.env` ships with
# the package and the admin is not supposed to edit it.
PROJECT=mlab-autojoin
LOCATE_URL=locate.measurementlab.net
AUTH_URL=auth.mlab-oti.measurementlab.net
