# Configuration for the M-Lab node (mlab-node) services.
#
# This file is sourced by the systemd units as an EnvironmentFile. The
# package installer fills in the values below from its questions; to go
# through them again (pre-filled with the current values) run:
#
#   dpkg-reconfigure mlab-node
#
# Editing the file directly works too; the package only ever replaces the
# KEY=value lines it asks about and keeps everything else. After editing,
# restart the stack with:
#
#   systemctl restart mlab-node.target
#
# This file is world-readable: do not put secrets in it. The API key is
# kept separately in /etc/mlab-node/api-key.env (0600 root:root).

# IATA is the 3-letter IATA code (either case) of the nearest large
# international airport: the largest one serving this machine's metro, not the
# closest airfield. International airports by country, with IATA codes:
# https://en.wikipedia.org/wiki/List_of_international_airports_by_country
IATA=

# PROBABILITY is the probability (0-1) that this node is selected by M-Lab's
# load balancer. Default is 0.1 (10%).
PROBABILITY=0.1

# INTERFACE_NAME is the network interface to which INTERFACE_MAXRATE applies.
INTERFACE_NAME=

# UPLINK is the uplink speed, an integer followed by "g" (e.g. "1g", "10g",
# "25g"). Minimum is 1g; 10g or greater is recommended.
UPLINK=

# INTERFACE_MAXRATE is the rate (bit/s) above which ndt-server refuses new
# connections. Recommended: 1G -> 150000000, 10G -> 7000000000. The installer
# asks for it in Mbit/s and converts.
INTERFACE_MAXRATE=

# IPV4 is the external IPv4 address this node is reachable at. Required.
IPV4=

# IPV6 is the external IPv6 address this node is reachable at. Optional; set it
# to make the node accessible over IPv6.
IPV6=

# TYPE is "physical" (bare-metal dedicated to M-Lab) or "virtual" (a VM).
TYPE=
