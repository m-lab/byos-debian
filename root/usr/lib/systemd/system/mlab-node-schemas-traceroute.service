[Unit]
Description=Generate scamper2 and hopannotation2 JSON schemas
Documentation=https://github.com/m-lab/byos-debian
PartOf=mlab-node.target
# Generates the scamper2/hopannotation2 table schemas for jostler.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/mlab-node/generate-schemas-traceroute \
  -scamper2=/var/lib/mlab-node/schemas/scamper2.json \
  -hopannotation2=/var/lib/mlab-node/schemas/hopannotation2.json

# --- hardening ---
User=mlab-node
Group=mlab-node
ReadWritePaths=/var/lib/mlab-node/schemas
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
