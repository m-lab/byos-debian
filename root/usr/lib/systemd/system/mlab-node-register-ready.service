[Unit]
Description=Wait for M-Lab node registration to be ready
Documentation=https://github.com/m-lab/byos-debian
PartOf=mlab-node.target
After=mlab-node-register.service
Wants=mlab-node-register.service
# This oneshot gates every dependent component on a successful registration
# (the register-node :8001/ready endpoint), so the hostname, registration.json
# and service-account files exist before anything reads them. It then exports
# what components need from the registration as environment
# (/run/mlab-node/metadata/registration.env, currently ORGANIZATION).

[Service]
Type=oneshot
RemainAfterExit=yes
# Poll until registration reports ready: retry connection-refused (register
# still starting) and HTTP errors (not yet registered) for up to ~120s.
ExecStart=/usr/bin/curl -fsS -o /dev/null \
  --retry 60 --retry-delay 2 --retry-connrefused --retry-all-errors \
  http://localhost:8001/ready
ExecStartPost=/usr/libexec/mlab-node/write-registration-env

# --- hardening ---
User=mlab-node
Group=mlab-node
ReadWritePaths=/run/mlab-node/metadata
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
