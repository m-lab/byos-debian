[Unit]
Description=Write external IP metadata files for traceroute-caller
Documentation=https://github.com/m-lab/byos-debian
PartOf=mlab-node.target
# Writes ${IPV4}/${IPV6} to the external-ip[v6] metadata files that
# traceroute-caller reads. Regenerated each boot (the files live on the /run
# tmpfs).

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/mlab-node/node.env
ExecStart=/usr/libexec/mlab-node/write-metadata

# --- hardening ---
User=mlab-node
Group=mlab-node
ReadWritePaths=/run/mlab-node/metadata
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
