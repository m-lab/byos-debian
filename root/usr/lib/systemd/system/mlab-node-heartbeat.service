[Unit]
Description=M-Lab heartbeat (reports liveness to the Locate API)
Documentation=https://github.com/m-lab/byos-debian
PartOf=mlab-node.target
Requires=mlab-node-register-ready.service
After=mlab-node-register-ready.service
# Soft dependency on ndt-server: order after it but do not tear heartbeat
# down if ndt-server restarts.
Wants=mlab-node-ndt-server.service
After=mlab-node-ndt-server.service
# Atomic lifecycle: bound to register-node, the keystone of the stack.
BindsTo=mlab-node-register.service

[Service]
Type=exec
EnvironmentFile=/usr/share/mlab-node/static.env
EnvironmentFile=/etc/mlab-node/node.env
EnvironmentFile=/etc/mlab-node/api-key.env
ExecStart=/usr/libexec/mlab-node/heartbeat \
  -prometheusx.listen-address=:9993 \
  -experiment=ndt \
  -hostname=@/run/mlab-node/registration/shared/hostname \
  -registration-url=file:///run/mlab-node/registration/shared/registration.json \
  -heartbeat-url=wss://${LOCATE_URL}/v2/platform/heartbeat-jwt \
  -api-key=${API_KEY} \
  -token-exchange-url=https://${AUTH_URL}/v0/token/autojoin \
  -services=ndt/ndt7=ws:///ndt/v7/download,ws:///ndt/v7/upload,wss:///ndt/v7/download,wss:///ndt/v7/upload
Restart=always
RestartSec=5

# --- hardening ---
User=mlab-node
Group=mlab-node
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
