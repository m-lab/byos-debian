[Unit]
Description=M-Lab jostler (archives results to GCS)
Documentation=https://github.com/m-lab/byos-debian
PartOf=mlab-node.target
# Requires all schemas to be generated (service_completed_successfully) and a
# successful registration.
Requires=mlab-node-schemas-ndt7.service mlab-node-schemas-annotation2.service mlab-node-schemas-traceroute.service
# Bound to the registration gate: stopped when the registration goes stale,
# started again (by mlab-node.target) once it is valid.
BindsTo=mlab-node-register-ready.service
After=mlab-node-register-ready.service mlab-node-schemas-ndt7.service mlab-node-schemas-annotation2.service mlab-node-schemas-traceroute.service

[Service]
Type=exec
EnvironmentFile=/usr/share/mlab-node/static.env
EnvironmentFile=/etc/mlab-node/node.env
# ORGANIZATION, derived from the registration by register-ready.
EnvironmentFile=/run/mlab-node/metadata/registration.env
Environment=GOOGLE_APPLICATION_CREDENTIALS=/run/mlab-node/registration/private/gcs-credentials.json
ExecStart=/usr/libexec/mlab-node/jostler \
  -mlab-node-name=@/run/mlab-node/registration/shared/hostname \
  -gcs-bucket=archive-${PROJECT} \
  -gcs-data-dir=autoload/v2 \
  -local-data-dir=/var/spool/mlab-node \
  -organization=${ORGANIZATION} \
  -experiment=ndt \
  -datatype=ndt7 \
  -datatype-schema-file=ndt7:/var/lib/mlab-node/schemas/ndt7.json \
  -datatype=annotation2 \
  -datatype-schema-file=annotation2:/var/lib/mlab-node/schemas/annotation2.json \
  -datatype=scamper2 \
  -datatype-schema-file=scamper2:/var/lib/mlab-node/schemas/scamper2.json \
  -datatype=hopannotation2 \
  -datatype-schema-file=hopannotation2:/var/lib/mlab-node/schemas/hopannotation2.json \
  -bundle-size-max=20971520 \
  -bundle-age-max=1h \
  -missed-age=2h \
  -missed-interval=5m \
  -extensions=.json \
  -upload-schema=false \
  -verbose \
  -prometheusx.listen-address=:9991
Restart=always
RestartSec=5

# --- hardening ---
User=mlab-node
Group=mlab-node
SupplementaryGroups=mlab-node-ndt
ReadWritePaths=/var/spool/mlab-node
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
