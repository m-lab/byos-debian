[Unit]
Description=M-Lab node registration (Autojoin API)
Documentation=https://github.com/m-lab/byos-debian
PartOf=mlab-node.target
After=network-online.target
Wants=network-online.target
# Like a container in a pod, register-node restarts on its own and never gives
# up: it exits on any registration error (API or network down), so a start
# limit would turn a transient outage into a permanent one. The other
# components keep running across its restarts.
StartLimitIntervalSec=0

[Service]
Type=exec
EnvironmentFile=/usr/share/mlab-node/static.env
EnvironmentFile=/etc/mlab-node/node.env
EnvironmentFile=/etc/mlab-node/api-key.env
ExecStart=/usr/libexec/mlab-node/autojoin-register \
  -endpoint=https://autojoin-dot-${PROJECT}.appspot.com/autojoin/v0/node/register/token \
  -token-endpoint=https://${AUTH_URL}/v0/token/autojoin \
  -key=${API_KEY} \
  -service=ndt \
  -iata=${IATA} \
  -output=/run/mlab-node/registration/shared \
  -output-secure=/run/mlab-node/registration/private \
  -healthcheck-addr=:8001 \
  -ports=9990,9991,9992,9993,9994,9995 \
  -probability=${PROBABILITY} \
  -ipv4=${IPV4} \
  -ipv6=${IPV6} \
  -type=${TYPE} \
  -uplink=${UPLINK}
Restart=always
RestartSec=10

# --- hardening ---
User=mlab-node
Group=mlab-node
ReadWritePaths=/run/mlab-node/registration
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
