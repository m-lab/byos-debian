[Unit]
Description=M-Lab uuid-annotator (network/geo annotations)
Documentation=https://github.com/m-lab/byos-debian
PartOf=mlab-node.target
Requires=mlab-node-register-ready.service
After=mlab-node-register-ready.service
# Soft dependency on ndt-server: the annotator connects to ndt-server's
# tcpinfo .../events/sock, but must not be torn down if ndt-server restarts.
Wants=mlab-node-ndt-server.service
After=mlab-node-ndt-server.service
BindsTo=mlab-node-register.service

[Service]
Type=exec
EnvironmentFile=/usr/share/mlab-node/static.env
EnvironmentFile=/etc/mlab-node/node.env
Environment=GOOGLE_APPLICATION_CREDENTIALS=/var/lib/mlab-node/node/private/service-account-autojoin.json
# Wait for ndt-server's events socket, and clear any stale annotator socket.
ExecStartPre=/usr/libexec/mlab-node/wait-socket /run/mlab-node/sockets/ndt/events/sock
ExecStartPre=/bin/rm -f /run/mlab-node/sockets/ndt/uuid-annotator/sock
ExecStart=/usr/libexec/mlab-node/uuid-annotator \
  -prometheusx.listen-address=:9992 \
  -datadir=/var/lib/mlab-node/resultsdir/ndt/annotation2 \
  -tcpinfo.eventsocket=/run/mlab-node/sockets/ndt/events/sock \
  -ipservice.sock=/run/mlab-node/sockets/ndt/uuid-annotator/sock \
  -maxmind.url=gs://downloader-${PROJECT}/Maxmind/current/GeoLite2-City.tar.gz \
  -routeview-v4.url=gs://downloader-${PROJECT}/RouteViewIPv4/current/routeview.pfx2as.gz \
  -routeview-v6.url=gs://downloader-${PROJECT}/RouteViewIPv6/current/routeview.pfx2as.gz \
  -siteinfo.url=file:///var/lib/mlab-node/node/shared/annotation.json \
  -asname.url=file:///usr/share/mlab-node/asnames.ipinfo.csv \
  -hostname=@/var/lib/mlab-node/node/shared/hostname
Restart=always
RestartSec=5

# --- privilege separation ---
User=mlab-node
Group=mlab-node
UMask=0002

# --- hardening ---
ReadWritePaths=/var/lib/mlab-node/resultsdir/ndt/annotation2 \
  /run/mlab-node/sockets/ndt/uuid-annotator
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
# AF_NETLINK is required to enumerate the host's local addresses (the annotator
# reads them via netlink to annotate the server side of each measurement).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
