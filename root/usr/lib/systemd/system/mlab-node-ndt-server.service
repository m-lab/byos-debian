[Unit]
Description=M-Lab ndt-server (NDT7 measurement service)
Documentation=https://github.com/m-lab/byos-debian
PartOf=mlab-node.target
# Start ordering / gating:
#   register-ready  -> registration succeeded
#   schemas-ndt7    -> ndt7 schema generated
#   uuidprefix/bbr  -> prerequisites generated/loaded
Requires=mlab-node-schemas-ndt7.service mlab-node-uuidprefix.service mlab-node-bbr.service
# Bound to the registration gate: stopped when the registration goes stale,
# started again (by mlab-node.target) once it is valid.
BindsTo=mlab-node-register-ready.service
After=mlab-node-register-ready.service mlab-node-schemas-ndt7.service mlab-node-uuidprefix.service mlab-node-bbr.service

[Service]
Type=exec
EnvironmentFile=/etc/mlab-node/node.env
# ORGANIZATION, derived from the registration by register-ready.
EnvironmentFile=/run/mlab-node/metadata/registration.env
# INTERFACE_MAXRATE, derived from UPLINK by register-ready. Listed after
# node.env so it wins over a leftover assignment there.
EnvironmentFile=/run/mlab-node/metadata/maxrate.env
# Clear any stale tcpinfo socket left by a previous instance before binding.
ExecStartPre=/bin/rm -f /run/mlab-node/sockets/ndt/events/sock
ExecStart=/usr/libexec/mlab-node/ndt-server \
  -uuid-prefix-file=/var/lib/mlab-node/schemas/uuid.prefix \
  -datadir=/var/spool/mlab-node/ndt \
  -htmldir=/usr/share/mlab-node/html \
  -ndt7_addr=:443 \
  -ndt7_addr_cleartext=:80 \
  -compress-results=false \
  -txcontroller.device=${INTERFACE_NAME} \
  -txcontroller.max-rate=${INTERFACE_MAXRATE} \
  -prometheusx.listen-address=:9990 \
  -label=type=${TYPE} \
  -label=deployment=byos \
  -label=managed=none \
  -label=loadbalanced=false \
  -label=org=${ORGANIZATION} \
  -label=external-ip=${IPV4} \
  -label=external-ipv6=${IPV6} \
  -ndt5_addr=127.0.0.1:3002 \
  -ndt5_ws_addr=127.0.0.1:3001 \
  -tcpinfo.eventsocket=/run/mlab-node/sockets/ndt/events/sock \
  -autocert.enabled=true \
  -autocert.dir=/var/lib/mlab-node/autocert/ndt \
  -autocert.hostname=@/run/mlab-node/registration/shared/hostname \
  -token.machine=@/run/mlab-node/registration/shared/hostname \
  -token.verify-key=/etc/mlab-node/locate/verify.pub \
  -ndt7.token.required=true
Restart=always
RestartSec=5

# Graceful (lame-duck) stop. ndt-server's signal protocol is two SIGTERMs.
# The first flips /health (127.0.0.1:8000) to 500; heartbeat notices within
# 10s and reports score 0, so Locate stops directing new clients here. The
# second exits the server. ExecStop sends the first and waits out the drain
# window; when it returns, systemd delivers its regular KillSignal (SIGTERM)
# as the second, and the server exits cleanly with in-flight tests finished.
# The window mirrors the k8s platform's 100s termination grace period (10s
# heartbeat notice + 30s Locate propagation + 60s max test length). Do not
# send the second SIGTERM from the script: ndt-server closes its signal
# channel after the second, so a third could panic the exiting process.
ExecStop=/bin/sh -c 'kill -s TERM "$MAINPID"; sleep 100'
# Bounds each stop phase (ExecStop above, then the SIGTERM kill phase)
# separately; must exceed the 100s drain or systemd would SIGKILL mid-drain.
TimeoutStopSec=130

# --- privilege separation ---
User=mlab-node-ndt
Group=mlab-node-ndt
UMask=0002

# --- hardening ---
# Bind the privileged ports 80/443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ReadWritePaths=/var/spool/mlab-node/ndt/ndt5 \
  /var/spool/mlab-node/ndt/ndt7 \
  /var/lib/mlab-node/autocert/ndt \
  /run/mlab-node/sockets/ndt/events
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateTmp=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
# AF_NETLINK is required by -txcontroller to read the interface transmit rate.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
