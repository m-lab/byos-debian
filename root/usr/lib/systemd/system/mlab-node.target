[Unit]
Description=M-Lab BYOS node measurement stack
Documentation=https://github.com/m-lab/byos-debian
# The target is the single handle for the whole stack. Starting it pulls in
# every component; stopping it stops them all (each component is PartOf= this
# target). Upholds= makes it play the kubelet's role:
# while the target is up, any component found inactive or failed is started
# again, e.g. after one of its oneshot prerequisites failed. Together with
# Restart=always on each component this gives pod semantics: components
# restart individually and indefinitely, and never take each other down.
# Wants= is kept next to it because a systemd older than 249 ignores Upholds=,
# and the stack would then not start at all.
Wants=mlab-node-register.service
Wants=mlab-node-ndt-server.service
Wants=mlab-node-heartbeat.service
Wants=mlab-node-uuid-annotator.service
Wants=mlab-node-jostler.service
Wants=mlab-node-traceroute-caller.service
Wants=mlab-node-node-exporter.service
Upholds=mlab-node-register.service
Upholds=mlab-node-ndt-server.service
Upholds=mlab-node-heartbeat.service
Upholds=mlab-node-uuid-annotator.service
Upholds=mlab-node-jostler.service
Upholds=mlab-node-traceroute-caller.service
Upholds=mlab-node-node-exporter.service

[Install]
WantedBy=multi-user.target
