[Unit]
Description=M-Lab traceroute-caller (runs scamper traceroutes)
Documentation=https://github.com/m-lab/byos-debian
PartOf=mlab-node.target
Requires=mlab-node-register-ready.service mlab-node-schemas-traceroute.service mlab-node-metadata.service
After=mlab-node-register-ready.service mlab-node-schemas-traceroute.service mlab-node-metadata.service
# traceroute-caller connects to ndt-server's .../events/sock: order after it and
# wait for the socket in ExecStartPre.
Wants=mlab-node-ndt-server.service
After=mlab-node-ndt-server.service

[Service]
Type=exec
EnvironmentFile=/etc/mlab-node/node.env
ExecStartPre=/usr/libexec/mlab-node/wait-socket \
  /run/mlab-node/sockets/ndt/events/sock \
  /run/mlab-node/sockets/ndt/uuid-annotator/sock
ExecStart=/usr/libexec/mlab-node/traceroute-caller \
  -scamper.bin=/usr/libexec/mlab-node/scamper \
  -prometheusx.listen-address=:9994 \
  -traceroute-output=/var/spool/mlab-node/ndt/scamper2 \
  -hopannotation-output=/var/spool/mlab-node/ndt/hopannotation2 \
  -tcpinfo.eventsocket=/run/mlab-node/sockets/ndt/events/sock \
  -IPCacheTimeout=10m \
  -IPCacheUpdatePeriod=1m \
  -scamper.timeout=30m \
  -scamper.waitprobe=15 \
  -scamper.ptr=true \
  -ipservice.sock=/run/mlab-node/sockets/ndt/uuid-annotator/sock \
  -anonymize.ip=none \
  -scamper.trace-type=regular \
  -output.format=json
Restart=always
RestartSec=5

# --- privilege separation ---
User=mlab-node-ndt
Group=mlab-node-ndt
UMask=0002

# --- hardening ---
# scamper needs raw sockets to send/receive probes; the child inherits the
# ambient capability from traceroute-caller.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
ReadWritePaths=/var/spool/mlab-node/ndt/hopannotation2 \
  /var/spool/mlab-node/ndt/scamper2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateTmp=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Relaxed for the bundled scamper C binary.
MemoryDenyWriteExecute=no
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK AF_PACKET
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
