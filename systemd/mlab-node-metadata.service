[Unit]
Description=Write external IP metadata files for traceroute-caller
Documentation=https://github.com/m-lab/byos-debian
PartOf=mlab-node.target
# Materializes ${IPV4}/${IPV6} as the external-ip[v6] metadata files that
# traceroute-caller reads. Regenerated each boot (the files live on the /run
# tmpfs).

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/mlab/mlab-node.env
ExecStart=/usr/lib/mlab/write-metadata

# --- hardening ---
User=mlab-node
Group=mlab-node
ReadWritePaths=/run/mlab/metadata
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
